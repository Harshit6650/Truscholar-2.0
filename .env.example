# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. `.env.local` is git-ignored.
# Never commit real credentials. Anything prefixed NEXT_PUBLIC_ is shipped to
# the browser — treat it as public.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development

# Public site URL — used for canonical URLs, sitemap, robots, OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side base URL for internal API calls (leave blank to use relative URLs)
API_BASE_URL=

# --- Database (uncomment once a driver is chosen) ---------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/truscholar

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 32
# AUTH_SECRET=

# --- Feature flags ---------------------------------------------------------
NEXT_PUBLIC_ENABLE_ANALYTICS=false
